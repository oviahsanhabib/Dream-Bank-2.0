@page
@model Dream_Bank.Pages.Clients.DepositModel
@{
}

<pre></pre>
<div class="col-11 mx-auto pt-0">
    <div class="card">
        <div class="card-header bg-info text-uppercase text-white">
            <h4>Deposit</h4>
        </div>

     </div>
        <pre></pre>

        <form method="post">
            <input type="hidden" name="id" value="@Model.clientInfo.id">



    <div class="row mb-3">
        <label class="col-sm-3 col-form-label">First Name</label>
        <div class="col-sm-6">
            <input type="text" class="form-control" name="fname" value="@Model.clientInfo.fname" readonly>
        </div>
    </div>
    <div class="row mb-3">
        <label class="col-sm-3 col-form-label">Last Name</label>
        <div class="col-sm-6">
            <input type="text" class="form-control" name="lname" value="@Model.clientInfo.lname" readonly>
        </div>
    </div>

            <div class="row mb-3">
                <label class="col-sm-3 col-form-label">Account No</label>
                <div class="col-sm-6">
                    <input type="text" class="form-control" name="account_no" value="@Model.clientInfo.account_no" readonly>
                </div>
            </div>


            <div class="row mb-3">
                <label class="col-sm-3 col-form-label">Account Type</label>
                <div class="col-sm-6">
                    <input type="text" class="form-control" name="account_type" value="@Model.clientInfo.account_type" readonly>
                </div>
            </div>



            <div class="row mb-3">
                <label class="col-sm-3 col-form-label">Email</label>
                <div class="col-sm-6">
                    <input type="text" class="form-control" name="email" value="@Model.clientInfo.email" readonly>
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-3 col-form-label">Phone</label>
                <div class="col-sm-6">
                    <input type="text" class="form-control" name="phone" value="@Model.clientInfo.phone" readonly>
                </div>
            </div>

             <div class="row mb-3">
                <label class="col-sm-3 col-form-label">Current Ballance</label>
                <div class="col-sm-6">
                    <input type="text" class="form-control" name="cbalance" value="@Model.clientInfo.indeposit" readonly>
                </div>
            </div>


            <div class="row mb-3">
                <label class="col-sm-3 col-form-label"> Deposit Amount</label>
                <div class="col-sm-6">
                    <input type="number" class="form-control" name="indeposit" value="@Model.clientInfo.indeposit" required>
                </div>
            </div>






            <div class="row mb-3">
                <div class="offset-sm-3 col-sm-3 d-grid">
                    <button type="submit" class="btn btn-primary">Deposit</button>
                </div>
                <div class="col-sm-3 d-grid">
                <a class="btn btn-outline-primary" href="/Clients/DepositMain" role="button">Cancle</a>
                </div>
            </div>


        </form>
    </div>
