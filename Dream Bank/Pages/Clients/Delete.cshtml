@page
@model Dream_Bank.Pages.Clients.Delete1Model
@{
}
<pre></pre>
<div class="col-11 mx-auto pt-1">
    <div class="card">
        <div class="card-header bg-danger text-uppercase text-white">
            <h4>Are you sure You want to Delete this client Information?</h4>
        </div>


    </div>
    <pre></pre>

    @if (Model.errorMessage.Length > 0)
    {
        <div class='alert alert-warning alert-dismissible fade show' role='alert'>
            <strong>@Model.errorMessage</strong>
            <button type="button" class="btn-close" data-bs-dissmiss='alert'> </button>
        </div>
    }



    <form method="post">
        <input type="hidden" name="id" value="@Model.clientInfo.id">


        <div class="row mb-3">
            <label class="col-sm-3 col-form-label">First Name</label>
            <div class="col-sm-6">
                <input type="text" class="form-control" name="fname" value="@Model.clientInfo.fname" readonly>
            </div>
        </div>

        <div class="row mb-3">
            <label class="col-sm-3 col-form-label">Last Name</label>
            <div class="col-sm-6">
                <input type="text" class="form-control" name="lname" value="@Model.clientInfo.lname" readonly>
            </div>
        </div>


        <div class="row mb-3">
            <label class="col-sm-3 col-form-label">Account No</label>
            <div class="col-sm-6">
                <input type="text" class="form-control" name="account_no" value="@Model.clientInfo.account_no" readonly>
            </div>
        </div>

        


        @if (Model.successMessage.Length > 0)
        {
            <div class="row mb-3">
                <div class="col-sm-9">
                    <div class='alert alert-success alert-dismissible fade show' role='alert'>
                        <strong>@Model.successMessage</strong>
                        <button type="button" class="btn-close" data-bs-dissmiss='alert'> </button>
                    </div>
                </div>
            </div>
        }



       


        <div class="row mb-3">
            <div class="offset-sm-3 col-sm-3 d-grid">
                <button type="submit" class="btn btn-danger">Yes</button>
            </div>
            <div class="col-sm-3 d-grid">
                <a class="btn btn-outline-primary" href="/Clients/Update" role="button">Cancle</a>
            </div>
        </div>


    </form>
</div>
