                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="p-4 border border-primary rounded">
                                        <h2 class="mb-4">Upload Client Photo</h2>
                                        <form method="post" enctype="multipart/form-data">
                                            <div class="mb-3">
                                                <label for="img" class="form-label">Choose an image:</label>
                                                <input type="file" class="form-control form-control-sm" name="img" accept="image/*" onchange="updatePreview(this, 'image-preview')" required />
                                            </div>
                                            <!-- other form fields here -->
                                            <div class="d-grid gap-2 mt-4">
                                                <button type="submit" class="btn btn-primary">Submit</button>
