                        <div class="col-md-6">
                            <label for="text" class="form-label">First Name</label>
                            <input type="text" class="form-control" name="fname" placeholder="First name" value="@Model.clientInfo.fname" required>
                        </div>
                        <div class="col-md-6">
                            <label for="text" class="form-label">Last Name</label>
                            <input type="text" class="form-control" name="lname" placeholder="Last name" value="@Model.clientInfo.lname" required>
                        </div>



                        <div class="col-12">
                            <label for="text" class="form-label">Account No</label>
                            <input type="text" class="form-control" name="account_no" placeholder="Account Number will be autogenerated" value="@Model.clientInfo.account_no" readonly>
                        </div>


                    

                        <div class="col-md-4">
           
                            <label for="inputState" class="form-label">Account Type</label>
                            <select name="account_type" class="custom-select" value="@Model.clientInfo.account_type" id="account_type">
                                <option selected>Select Account Type</option>
                                <option value="Checking">Checking Account</option>
                                <option value="Savings">Savings Account</option>

                            </select>
                        </div>



                        <div class="col-md-4">
                            <label for="inputState" class="form-label">Gender</label>
                            <select name="gender" class="custom-select" value="@Model.clientInfo.gender" id="gender">
                                <option selected>Select Gender</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Others">Others</option>

                            </select>
                        </div>




                        <div class="col-md-4">
                            <label for="inputState" class="form-label">Date of Birth</label>
                            <input type="date" class="form-control" name="dob" value="@Model.clientInfo.dob" required>
                        </div>





