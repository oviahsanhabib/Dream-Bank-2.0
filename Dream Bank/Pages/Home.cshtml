@page
@model Dream_Bank.Pages.HomeModel
@{
    ViewData["Title"] = "Home page";
}

<pre></pre>
<pre></pre>
<pre></pre>
<pre></pre>
<pre></pre>
<pre></pre>

<div class="container mt-5">
    <div class="row">


        <div class="col-md-4">
            <div class="card bg-info text-white">
                <div class="card-header">
                    Total Clients
                </div>
                <div class="card-body d-flex align-items-center">
                    <img src="/img/user.png" class="rounded-circle mr-3" alt="Product Photo" width="80" height="80">
                    <div>
                        <h5 class="card-title big-text">@Model.ClientsNumber</h5>
                    </div>
                </div>
            </div>
        </div>


        <div class="col-md-4">
            <div class="card bg-success text-white">
                <div class="card-header">
                    Total Deposit
                </div>
                <div class="card-body d-flex align-items-center">
                    <img src="/img/money.png" class="rounded-circle mr-3" alt="Product Photo" width="80" height="80">
                    <div>
                        <h5 class="card-title big-text">$@Model.TotalAmount</h5>
                      
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-secondary text-white">
                <div class="card-header">
                    Total Transactions Today
                </div>
                <div class="card-body  d-flex align-items-center">
                    <img src="/img/transactions.png" class="rounded-circle mr-3" alt="Product Photo" width="80" height="80">
                    <div>
                        <h5 class="card-title big-text">@Model.TotalTransactionCount</h5>
                       
                    </div>
                </div>
            </div>
        </div>

        <!-- Add more cards as needed -->

    </div>
</div>